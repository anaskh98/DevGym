      "text": "How far back do recent orders go?",
      "status": "answered_by_po",
      "answer": "The last 90 days.",
      "created_at": "2026-11-16 14:17:55"
    },
    {
      "id": "9fff2d99-3326-43f6-a175-b8a3377418d8",
      "text": "Are cancelled orders in the export?",
