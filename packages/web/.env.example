# Copy to .env.local to change.

# "mock" reads the JSON files in public/mock. "live" calls the local REST API (BE-12).
# Switching from mocks to real data is this one line.
VITE_API_MODE=mock

# Where the local REST API listens. Used in live mode only.
VITE_API_BASE=http://127.0.0.1:4317

# Mock mode only: "mock" is the committed sample; "mock-local" is your own
# database, written by `pnpm db:export-mock`.
VITE_MOCK_DIR=mock
