{
  "name": "@ftc/server",
  "version": "0.1.0",
  "private": true,
  "description": "Local service: MCP server, SQLite store and REST API.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "node dist/db/cli.js migrate",
    "db:seed": "node dist/db/cli.js seed",
    "db:status": "node dist/db/cli.js status",
    "bundle": "node bundle.mjs",
    "api": "node ../plugin/server/start.mjs api"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "web-tree-sitter": "^0.27.2",
    "zod": "^4.6.7"
  }
}
